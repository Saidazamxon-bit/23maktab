{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/backend/:path*",
      "destination": "https://6a70174330801.xvest4.ru/23maktab/:path*"
    },
    {
      "source": "/((?!backend/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/backend/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}